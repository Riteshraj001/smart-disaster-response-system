# Existing Spring Boot incident API
VITE_API_BASE_URL=http://localhost:8080

# Configure these only if the backend exposes the corresponding operation.
# Use {id} for the incident id, for example /incidents/{id}/assign.
VITE_API_INCIDENT_STATUS_PATH=
VITE_API_INCIDENT_STATUS_METHOD=PATCH
VITE_API_ASSIGNEES_PATH=
VITE_API_INCIDENT_ASSIGNMENT_PATH=
VITE_API_INCIDENT_ASSIGNMENT_METHOD=PATCH
# Set to the exact backend DTO property (for example assignmentNote) if notes are supported.
VITE_API_ASSIGNMENT_NOTE_FIELD=
VITE_API_INCIDENT_VERIFY_PATH=
VITE_API_INCIDENT_VERIFY_METHOD=PATCH
# Set both only when the POST /incidents DTO accepts GPS values.
VITE_API_INCIDENT_LATITUDE_FIELD=
VITE_API_INCIDENT_LONGITUDE_FIELD=

# Optional geocoder override. Default is the public OpenStreetMap Nominatim endpoint.
# Set a custom provider or API endpoint here if your deployment uses a different geocoder.
VITE_GEOCODER_PROVIDER=nominatim
VITE_GEOCODER_ENDPOINT=https://nominatim.openstreetmap.org/search
